# Copy to .env before running Docker Compose: cp .env.example .env
# Never commit .env.

# Required server secret (at least 32 bytes) used by merton-api to derive CSRF tokens.
# Keep it stable across restarts. Generate one with: openssl rand -base64 48
APP_SECRET_KEY=

# Optional: a PostgreSQL database instead of SQLite on the merton-data volume,
# e.g. Neon's direct connection string (no -pooler in the host) with
# sslmode=require. Existing SQLite data is not copied over.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional: publish the stack on another host port than 18080. Set ORIGIN and
# APP_TRUSTED_ORIGINS to the same URL.
# MERTON_HTTP_PORT=8080
# ORIGIN=http://localhost:8080
# APP_TRUSTED_ORIGINS=http://localhost:8080

# Optional, `bun run dev` only: where the dev server forwards /api when
# merton-api runs outside Compose on a port other than 18080.
# MERTON_API_URL=http://127.0.0.1:8080

